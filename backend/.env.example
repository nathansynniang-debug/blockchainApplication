# Copy to .env
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000

# Seeded on first start (stored hashed). CHANGE THE PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional: wallets that get the admin role when they sign in with a wallet
# (comma separated). Hardhat account #0 shown as an example.
ADMIN_WALLETS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
